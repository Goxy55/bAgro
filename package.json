{
  "name": "agro-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "import": "python3 scripts/extract.py && tsx scripts/import.ts",
    "import:inputs": "tsx scripts/import-inputs.ts",
    "import:rzs": "tsx scripts/import-rzs.ts",
    "collect:rzs": "tsx scripts/collect-rzs.ts",
    "prepare:hosted-test": "tsx scripts/prepare-hosted-test.ts",
    "admin": "tsx scripts/admin.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@electric-sql/pglite": "0.5.11",
    "better-auth": "1.7.12",
    "cheerio": "1.2.0",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "multer": "2.5.0",
    "nodemailer": "10.2.0",
    "pdf-parse": "2.4.5",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
