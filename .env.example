# Generate: openssl rand -hex 32. Never commit .env.
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3000
PORT=3000
# Omit DATABASE_URL for persistent embedded PostgreSQL (one server process only).
# DATABASE_URL=postgresql://agro:password@localhost:5432/agro
# DATABASE_SSL=true
DATA_DIR=./data/postgres
# Keep 0 for direct access. Set 1 only behind a single controlled reverse proxy
# that is the only route to the application port (see deploy/compose.yaml).
TRUST_PROXY_HOPS=0
# Optional real reset emails. Development uses data/mail/*.json, never public.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=agro@example.com
